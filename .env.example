# Copy to .env (git-ignored) and set the required values.
# Without LLM API keys, all commands run in offline mock mode.

# Brand tracked by the GEO tracker. Define aliases under `brands:` in gtm_pilot/geo/prompts.yaml.
GTM_BRAND=
# GTM_MODE=mock          # force mock mode regardless of configured keys

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# HubSpot service key or private app token; required for HubSpot sync.
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.schemas.contacts.write (for --setup).
HUBSPOT_TOKEN=
